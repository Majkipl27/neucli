{
  "name": "neucli",
  "version": "0.1.0",
  "description": "Generate React + Tailwind websites from YAML config",
  "type": "module",
  "bin": {
    "neucli": "./bin/cli.ts"
  },
  "main": "src/generator/index.ts",
  "scripts": {
    "generate": "node bin/cli.ts generate",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p ."
  },
  "keywords": [
    "react",
    "tailwind",
    "generator",
    "cli",
    "yaml"
  ],
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "ejs": "^3.1.10",
    "js-yaml": "^4.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  },
  "exports": {
    ".": "./src/generator/index.ts",
    "./core": "./src/core/index.ts",
    "./core/primitives": "./src/core/primitives/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "docs",
    "README.md",
    "LICENSE"
  ]
}
